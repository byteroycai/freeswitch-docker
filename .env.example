# =============================================================================
# freeswitch-docker runtime environment
# =============================================================================

# SIP password for default vanilla extensions (1000-1019).
# Leave empty or set to 'changeme'/'1234' to auto-generate a random one.
# The generated value is printed to container stdout once on first start.
FS_DEFAULT_PASSWORD=

# SIP domain that clients register against.
FS_DOMAIN=localhost

# Public IP for SIP/RTP advertised in SDP.
# Use 'auto' to let FreeSWITCH discover it via STUN (default).
FS_EXTERNAL_IP=auto

# Event Socket Layer password.
# Leave empty or set to 'ClueCon' to auto-generate.
FS_ESL_PASSWORD=

# ESL bind interface. Default: 127.0.0.1 (loopback only — recommended).
# Set to 0.0.0.0 ONLY with a strong password and a restrictive ACL.
FS_ESL_LISTEN_IP=127.0.0.1

# =============================================================================
# Bridge profile port mappings (docker compose --profile bridge)
# =============================================================================
# Defaults shift ports so the container can coexist with a host FreeSWITCH.
# SIP_PORT=5070
# SIP_TLS_PORT=5071
# SIP_EXT_PORT=5090
# ESL_PORT=8022
# WS_PORT=5067
# WSS_PORT=7444
# RTP_START=20000
# RTP_END=30000

# =============================================================================
# Bind-mount data directory (docker-compose.prod.bind.yml only)
# =============================================================================
# FS_DATA_DIR=/opt/freeswitch/data
